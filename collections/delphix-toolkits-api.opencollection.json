        {
          "info": {
            "name": "Get toolkit schema definitions.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/dct/v3/toolkits/schema_definitions"
          },
          "docs": "Get toolkit schema definitions."
        },
        {
          "info": {
            "name": "Upgrade an Inactive appdata toolkit",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/dct/v3/toolkits/:toolkitId/upgrade",
            "params": [
              {
                "name": "toolkitId",
                "value": "",
